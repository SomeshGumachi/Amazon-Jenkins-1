pipeline {
    agent any
	
	parameters {
		booleanParam(
			name: 'SEND_EMAIL',
			deafaultValue: true,
			description: 'Enable Email notification'
			
		)
	}
    stages {
        stage('build') {
            steps {
                 sh 'mvn clean install'
            }
        }
    }

    post{
        success{
			echo 'Build success'
			
			script {
				if (params.SEND_EMAIL) {
					emailext (
						subject: 'Build Sucessfull',
						body: 'please check console for detailed output',
						to: 'somesh.reports@gmail.com
					)
				}
			}
        }
  
       failure{
			echo 'Failure in the build'
			script {
				if (params.SEND_EMAIL) {
					emailext (
						subject: 'Build Failed',
						body: 'please check console for detailed output',
						to: 'somesh.reports@gmail.com
					)
				}
			}
       }
    }
}
